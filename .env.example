# Copy this file to .env and fill in your values. Never commit .env to git.

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
# Get this from Atlas → Connect → Drivers. Replace <user>, <password>, <cluster>.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Database name inside Atlas (default: find2stay)
DB_NAME=find2stay

# Set to "true" to refuse startup when MongoDB is unreachable (recommended for hosted demo).
# Leave unset or "false" to allow in-memory fallback (good for local dev without Atlas).
REQUIRE_MONGODB=false

# ── Sessions ──────────────────────────────────────────────────────────────────
# Generate a strong random string, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# REQUIRED in production. The app will refuse to start if this is missing in NODE_ENV=production.
SESSION_SECRET=change-me-before-going-live

# ── Server ────────────────────────────────────────────────────────────────────
# Hostinger sets this automatically; do not hardcode 3000 in production.
PORT=3000

# Set to "production" on Hostinger. Controls secure cookies and secret enforcement.
NODE_ENV=development
